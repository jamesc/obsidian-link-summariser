# LLM Provider Selection (REQUIRED)
# Valid values: google, ollama, azure
MODEL_PROVIDER=google

# Model name to use
MODEL=gemini-2.5-flash
# MODEL=llama3:latest  # For Ollama
# MODEL=gpt-4  # For Azure

# =============================================================================
# Google Gemini Configuration
# =============================================================================

# Google AI Studio API key (required when MODEL_PROVIDER=google)
GEMINI_API_KEY=your_api_key_here

# Gemini API rate limits (optional, only applies to Google provider)
# GEMINI_RPM_LIMIT=5
# GEMINI_TPM_LIMIT=250000
# GEMINI_DAILY_LIMIT=20

# =============================================================================
# Ollama Configuration
# =============================================================================

# Ollama server endpoint (optional, defaults to http://localhost:11434)
# OLLAMA_ENDPOINT=http://localhost:11434

# =============================================================================
# Azure / Microsoft Foundry Configuration
# =============================================================================

# Azure OpenAI API key (required when MODEL_PROVIDER=azure)
# AZURE_API_KEY=your_azure_api_key_here

# Azure OpenAI endpoint URL (required when MODEL_PROVIDER=azure)
# Format: https://{your-resource-name}.openai.azure.com
# AZURE_ENDPOINT=https://your-resource.openai.azure.com

# Azure OpenAI deployment name (optional, defaults to MODEL when omitted)
# AZURE_DEPLOYMENT_NAME=your-deployment-name

# Azure OpenAI API version (optional, defaults to 2024-02-15-preview)
# AZURE_API_VERSION=2024-02-15-preview

# Azure rate limits (optional)
# AZURE_RPM_LIMIT=100
# AZURE_TPM_LIMIT=90000
# AZURE_DAILY_LIMIT=5000

# =============================================================================
# Chat Mode Configuration (uses Azure OpenAI exclusively)
# =============================================================================

# Chat mode uses Azure OpenAI with a separate model from summarization
# This allows using a fast/cheap model for chat while keeping a quality model
# for summaries.

# Chat model name (optional, defaults to gpt-4.1-mini)
# CHAT_MODEL=gpt-4.1-mini

# Chat Azure endpoint (optional, defaults to AZURE_ENDPOINT)
# CHAT_AZURE_ENDPOINT=https://your-resource.openai.azure.com

# Chat Azure API key (optional, defaults to AZURE_API_KEY)
# CHAT_AZURE_API_KEY=your_azure_api_key_here

# Chat Azure deployment name (optional, defaults to CHAT_MODEL)
# CHAT_AZURE_DEPLOYMENT=gpt-4.1-mini

# =============================================================================
# General Settings
# =============================================================================

# Default Obsidian vault path (optional)
DEFAULT_VAULT_PATH=~/Notes
