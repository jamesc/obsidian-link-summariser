# Google AI Studio API key (required for Gemini models)
GEMINI_API_KEY=your_api_key_here

# Model selection (works for both Gemini and Ollama)
MODEL=gemini-2.5-flash
# MODEL=llama3:latest  # Use Ollama model instead

# Legacy: GEMINI_MODEL still supported for backward compatibility
# GEMINI_MODEL=gemini-2.5-flash  # Deprecated, use MODEL instead

# Ollama server endpoint (optional, defaults to http://localhost:11434)
# OLLAMA_ENDPOINT=http://localhost:11434

# Default Obsidian vault path (optional)
DEFAULT_VAULT_PATH=~/Notes

# Gemini API rate limits (optional, only applies to Gemini models)
# GEMINI_RPM_LIMIT=5
# GEMINI_TPM_LIMIT=250000
# GEMINI_DAILY_LIMIT=20
